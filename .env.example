ULTRON_DATASET_PATH=data/jarvis_dataset_v2/jarvis_laptop_commands_synthetic_v2.jsonl
ULTRON_AUDIT_LOG=.ultron/audit.jsonl
ULTRON_DRY_RUN=true
ULTRON_WORKSPACE=.
ULTRON_SAFE_ROOTS=.;~/Desktop;~/Documents;~/Downloads
ULTRON_SCREENSHOT_DIR=.ultron/screenshots
ULTRON_PLANNER_MODE=rules
ULTRON_LLM_PROVIDER=ollama
ULTRON_LLM_MODEL=qwen2.5:7b-instruct
ULTRON_LLM_ENDPOINT=http://localhost:11434
ULTRON_LLM_TIMEOUT_SECONDS=8
GROQ_API_KEY=replace_with_your_groq_key
DEEPGRAM_API_KEY=replace_with_your_deepgram_key
ULTRON_NEURAL_ROUTER_ENABLED=false
ULTRON_NEURAL_ROUTER_MODEL=.ultron/models/neural_router.pt
ULTRON_WAKE_WORD_PROVIDER=text
ULTRON_WAKE_PHRASES=ULTRON;Hey ULTRON
ULTRON_VAD_PROVIDER=energy
ULTRON_VAD_ENERGY_THRESHOLD=0.015
ULTRON_CLAP_SPIKE_RATIO=7.0
ULTRON_CLAP_MIN_RMS=0.012
ULTRON_CLAP_MIN_GAP_S=0.05
ULTRON_CLAP_MAX_GAP_S=0.35
ULTRON_CLAP_COOLDOWN_S=0.45
